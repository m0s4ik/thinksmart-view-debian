+	/*
+	 * Front camera rails, from the Lenovo DTB (camera@0): cam_vana is
+	 * pm8953_l17 at 2.85 V with GPIO 119 "CAM_VANA", cam_vdig is
+	 * pm8953_l2 at 1.2 V with GPIO 118 "CAM_VDIG". The GPIOs switch the
+	 * PMIC rails onto the module. A fixed regulator does not set the
+	 * voltage of its supply: pm8953_l2 is pinned at 1.2 V below.
+	 */
+	cam_vdda: cam-vdda-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vdda";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+
+		gpio = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l17>;
+
+		pinctrl-0 = <&cam_vdda_en_default>;
+		pinctrl-names = "default";
+	};
+
+	cam_vddd: cam-vddd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vddd";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+
+		gpio = <&tlmm 118 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l2>;
+
+		pinctrl-0 = <&cam_vddd_en_default>;
+		pinctrl-names = "default";
+	};
+
 	/* Speaker amp supplied from 20V DC input */
 	speaker_amp_pvdd: speaker-amp-pvdd-regulator {
