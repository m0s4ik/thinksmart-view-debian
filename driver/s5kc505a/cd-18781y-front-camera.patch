+&camss {
+	/* Lenovo DTB: qcom,mipi-csi-vdd-supply = pm8953_s3 */
+	vdda-supply = <&pm8953_s3>;
+
+	status = "okay";
+
+	ports {
+		/*
+		 * Lenovo: CSIPHY 0 / CSID 0, two data lanes. The 3-phase
+		 * CSIPHY driver numbers data lanes 0-3 and uses lane 7 for the
+		 * clock (as msm8953-xiaomi-daisy).
+		 */
+		port@0 {
+			reg = <0>;
+
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&front_cam_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	/* 8-bit address 0x6e in the Lenovo sensor library */
+	camera@37 {
+		compatible = "samsung,s5kc505a";
+		reg = <0x37>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&camss_mclk0_default &cam_front_default>;
+		pinctrl-names = "default";
+
+		/* Lenovo DTB camera@0: 2.85 V, 1.2 V, 1.8 V */
+		vdda-supply = <&cam_vdda>;
+		vddd-supply = <&cam_vddd>;
+		vddio-supply = <&pm8953_l6>;
+
+		orientation = <0>;	/* front */
+		/*
+		 * The read-out is upright with the device on its stand
+		 * (landscape). Lenovo's qcom,mount-angle 270 is relative to the
+		 * panel's native portrait orientation, not to the scene as in
+		 * video-interface-devices.yaml.
+		 */
+		rotation = <0>;
+
+		port {
+			front_cam_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <480000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
