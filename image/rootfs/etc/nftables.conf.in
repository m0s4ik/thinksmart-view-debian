#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andrea Mattera
# Inbound: only the TCP ports LAN_TCP_PORTS (default ssh) and mDNS (avahi) from the local network (LAN_V4 and LAN_V6
# of config.env), plus loopback, replies and ICMP; everything else is dropped. Outbound: open.
# Applications add their own inbound rules as /etc/nftables.d/*.nft: plain rule lines of this input chain, which can
# use $LAN_V4 and $LAN_V6 (see /etc/nftables.d/README). No file there: nothing more is open.
flush ruleset

define LAN_V4 = @LAN_V4@
define LAN_V6 = @LAN_V6@

table inet filter {
	chain input {
		type filter hook input priority filter; policy drop;

		iif lo accept comment "loopback"
		ct state established,related accept comment "replies to outgoing traffic"
		ct state invalid drop

		meta l4proto icmp accept comment "ICMP"
		meta l4proto ipv6-icmp accept comment "ICMPv6 (neighbor discovery, router advertisements)"
		ip6 saddr fe80::/10 udp dport 546 accept comment "DHCPv6 replies"

		ip saddr $LAN_V4 tcp dport @LAN_TCP_PORTS@ accept comment "LAN_TCP_PORTS from the LAN"
		ip6 saddr $LAN_V6 tcp dport @LAN_TCP_PORTS@ accept comment "LAN_TCP_PORTS from the LAN (IPv6)"
		ip saddr $LAN_V4 udp dport 5353 accept comment "mDNS from the LAN (avahi: <hostname>.local, service discovery)"
		ip6 saddr $LAN_V6 udp dport 5353 accept comment "mDNS from the LAN (IPv6)"

		include "/etc/nftables.d/*.nft"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
