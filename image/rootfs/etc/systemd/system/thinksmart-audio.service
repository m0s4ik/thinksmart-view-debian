# Audio setup at boot: waits for the cd-18781y card (module snd-soc-tas5782m, loaded by udev), applies the UCM
# profile (HiFi, Speaker, Microphone) and the speaker volume (/etc/default/thinksmart-audio).
[Unit]
Description=ThinkSmart View audio (cd-18781y card: UCM and volume)
After=systemd-udev-trigger.service msm-firmware-loader.service sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/thinksmart-audio
ExecStart=/usr/local/sbin/thinksmart-audio
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
