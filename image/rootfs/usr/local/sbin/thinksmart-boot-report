#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andrea Mattera
# Boot report (run by thinksmart-boot-report.service from the start of userspace): samples the CPU about once a
# second until systemd says the boot has finished, then writes ONE line to the journal (identifier thinksmart-boot):
# boot time, a small CPU benchmark (fastest/median/slowest), CPU frequency, temperature, and the order of two kernel
# messages. A SLOW boot (total above SLOW_TOTAL, or a benchmark sample SLOW_RATIO times the fastest, or above
# SLOW_BENCH_MS) also gets every sample and the CPU clock state taken WHILE it was slow (docs/known-issues.md#boot).
# Settings: /etc/default/thinksmart-boot-report. Files: $RUNTIME_DIRECTORY (/run/thinksmart-boot): samples,
# snapshot-*, report; default-target is touched by thinksmart-boot-report-done.service.
# Reads /proc and /sys only (and debugfs, when systemd has mounted it); never fails and exits by itself.
# It runs while the system boots, so it is kept cheap: a sample uses shell builtins only (no fork) apart from `sleep`;
# systemd is asked whether the boot has finished only once multi-user.target has been reached (and every 10th sample
# in case that never comes); temperatures and the clock state are read at the first sample and at the end.
# Test without the device: ROOT=<dir> prefixes every /sys path, RUNTIME_DIRECTORY=<dir> holds the files.
set -u
ROOT=${ROOT:-}
SYS=$ROOT/sys
OUT=${RUNTIME_DIRECTORY:-/run/thinksmart-boot}
FLAG=$OUT/default-target
# settings: whole numbers, else the default
case ${SLOW_TOTAL:-} in ''|*[!0-9]*) SLOW_TOTAL=30 ;; esac
case ${SLOW_RATIO:-} in ''|*[!0-9]*) SLOW_RATIO=5 ;; esac
case ${SLOW_BENCH_MS:-} in ''|*[!0-9]*) SLOW_BENCH_MS=0 ;; esac
case ${BENCH_LOOPS:-} in ''|*[!0-9]*) BENCH_LOOPS=2000 ;; esac
case ${MAX_WAIT:-} in ''|*[!0-9]*) MAX_WAIT=180 ;; esac
[ "$SLOW_RATIO" -ge 2 ] || SLOW_RATIO=2
# speed ratios are taken against at least FLOOR ms: the CPU time of a task is counted in scheduler ticks (4 ms at
# HZ=250), so a few-ms sample is too coarse to compare
FLOOR=10
POLICY=$SYS/devices/system/cpu/cpufreq/policy0
DEBUG=$SYS/kernel/debug

# set through rd and secs (eval)
cur='?'; hw='?'; online='?'; rc='?'; c='?'; h='?'; g='?'; mn='?'; mx='?'; tt='?'; s_total='?'; s_kern='?'; s_initrd='?'
s_user='?'

[ -d "$OUT" ] || mkdir -p "$OUT" 2>/dev/null
{ :; } 2>/dev/null > "$OUT/samples"

rd() {  # rd VAR FILE: first line of FILE into VAR, "?" if unreadable
    _v=
    read -r _v 2>/dev/null < "$2"
    eval "$1=\${_v:-?}"
}
uptime_cs() {  # uptime as text -> $up, in hundredths of a second -> $up_cs
    up=0.00
    read -r up _ 2>/dev/null < /proc/uptime
    _i=${up%.*}; _f=${up#*.}; _f=${_f#0}
    case $_i$_f in ''|*[!0-9]*) up_cs=0 ;; *) up_cs=$((_i * 100 + _f)) ;; esac
}
cpu_ns() {  # CPU time of this shell in ns (/proc/<pid>/schedstat, CONFIG_SCHED_INFO) -> $ns, -1 if not available
    ns=
    read -r ns _ 2>/dev/null < "/proc/$$/schedstat"
    case $ns in ''|*[!0-9]*) ns=-1 ;; esac
}
temps() {  # every thermal zone in degrees C -> $temps, the highest -> $tmax
    temps=; tmax=
    for z in "$SYS"/class/thermal/thermal_zone*/temp; do
        [ -e "$z" ] || continue
        v=; read -r v 2>/dev/null < "$z"
        case $v in
            ''|-|*[!0-9-]*|?*-*) v='?' ;;
            *) v=$((v / 1000)); { [ -z "$tmax" ] || [ "$v" -gt "$tmax" ]; } && tmax=$v ;;
        esac
        temps=${temps:+$temps,}$v
    done
}

count=0; fastest=0; slowest=0; prev=0; benches=; changes=0; snaps=0; files=
bench_kind=cpu
sample() {
    uptime_cs; t0=$up_cs; cpu_ns; n0=$ns
    i=0
    while [ $i -lt "$BENCH_LOOPS" ]; do i=$((i + 1)); done
    cpu_ns; n1=$ns; uptime_cs
    if [ "$n0" -ge 0 ] && [ "$n1" -ge "$n0" ]; then
        bench=$(( (n1 - n0) / 1000000 ))
    else
        bench=$(( (up_cs - t0) * 10 )); bench_kind=wall
    fi
    [ "$bench" -gt 0 ] || bench=1
    rd cur "$POLICY/scaling_cur_freq"; rd hw "$POLICY/cpuinfo_cur_freq"; rd online "$SYS/devices/system/cpu/online"
    count=$((count + 1))
    benches="$benches $bench"
    { [ "$fastest" = 0 ] || [ "$bench" -lt "$fastest" ]; } && fastest=$bench
    [ "$bench" -gt "$slowest" ] && slowest=$bench
    echo "sample t=${up}s bench=${bench}ms cur=$cur hw=$hw online=$online" 2>/dev/null >> "$OUT/samples"
}
# snapshot LABEL: the CPU clock state now (cpufreq of every policy, CPU clocks, CPU power domains, deferred probes,
# temperatures)
snapshot() {
    snaps=$((snaps + 1))
    files="$files $OUT/snapshot-$snaps"
    temps
    {
        echo "snapshot $snaps at ${up}s: $1; temperatures ${temps:-?} C"
        for p in "$SYS"/devices/system/cpu/cpufreq/policy*; do
            [ -d "$p" ] || continue
            rd rc "$p/related_cpus"; rd c "$p/scaling_cur_freq"; rd h "$p/cpuinfo_cur_freq"; rd g "$p/scaling_governor"
            rd mn "$p/scaling_min_freq"; rd mx "$p/scaling_max_freq"; rd tt "$p/stats/total_trans"
            echo "${p##*/}: cpus $rc cur $c hw $h governor $g min $mn max $mx transitions $tt"
            tis=
            while read -r k t; do tis="$tis $k:$t"; done < "$p/stats/time_in_state"
            echo "${p##*/} time_in_state (kHz:10ms)${tis:- ?}"
        done
        if [ -r "$DEBUG/clk/clk_summary" ]; then
            # the CPU clocks of msm8953 (drivers/clk/qcom/apcs-msm8953.c, a53-pll.c) and their parents
            sed -n -E -e '1,2p' -e '/apcs|a53pll|gpll0|cci|bimc|^ *xo/p' "$DEBUG/clk/clk_summary"
        else
            echo "no $DEBUG/clk/clk_summary (debugfs not mounted)"
        fi
        [ -r "$DEBUG/pm_genpd/pm_genpd_summary" ] && grep -iE 'domain|cpr|cpu' "$DEBUG/pm_genpd/pm_genpd_summary"
        if [ -r "$DEBUG/devices_deferred" ]; then
            d=
            while read -r l; do d="$d $l"; done < "$DEBUG/devices_deferred"
            echo "devices_deferred:${d:- none}"
        fi
    } 2>/dev/null > "$OUT/snapshot-$snaps"
}
finished() {  # systemd's timestamps (us); true once FinishTimestampMonotonic is set (boot transaction done)
    kern=0; initrd=0; user=0; fin=0
    for kv in $(systemctl show -p KernelTimestampMonotonic -p InitRDTimestampMonotonic -p UserspaceTimestampMonotonic \
            -p FinishTimestampMonotonic 2>/dev/null); do
        case $kv in
            KernelTimestampMonotonic=*) kern=${kv#*=} ;;
            InitRDTimestampMonotonic=*) initrd=${kv#*=} ;;
            UserspaceTimestampMonotonic=*) user=${kv#*=} ;;
            FinishTimestampMonotonic=*) fin=${kv#*=} ;;
        esac
    done
    case $kern in ''|*[!0-9]*) kern=0 ;; esac
    case $initrd in ''|*[!0-9]*) initrd=0 ;; esac
    case $user in ''|*[!0-9]*) user=0 ;; esac
    case $fin in ''|*[!0-9]*) fin=0 ;; esac
    [ "$fin" -gt 0 ]
}

unfinished=0
while :; do
    sample
    lo=$prev; [ "$lo" -ge "$FLOOR" ] || lo=$FLOOR
    hi=$bench; [ "$hi" -ge "$FLOOR" ] || hi=$FLOOR
    if [ "$count" = 1 ]; then
        snapshot "first sample"
    elif [ "$changes" -lt 4 ] && { [ "$bench" -ge $((lo * SLOW_RATIO)) ] || [ "$prev" -ge $((hi * SLOW_RATIO)) ]; }; then
        # the speed changed by SLOW_RATIO or more since the last sample: keep the state while slow and right after
        changes=$((changes + 1)); snapshot "benchmark ${prev}ms -> ${bench}ms"
    fi
    prev=$bench
    if [ -e "$FLAG" ] || [ $((count % 10)) = 0 ]; then
        finished && break
    fi
    if [ "$up_cs" -ge $((MAX_WAIT * 100)) ]; then
        finished && break
        unfinished=1; break
    fi
    sleep 1
done

# --- report ---------------------------------------------------------------------------------------------------------
secs() {  # secs VAR MICROSECONDS: "S.mmm" into VAR
    _ms=$(($2 / 1000 % 1000))
    [ "$_ms" -ge 100 ] || _ms=0$_ms
    [ "$_ms" -ge 10 ] || _ms=0$_ms
    eval "$1=$(($2 / 1000000)).$_ms"
}
slow=
if [ "$unfinished" = 1 ]; then
    times="boot not finished after ${up}s"
    slow="not finished"
else
    # as systemd-analyze: the postmarketOS initramfs is not systemd's, so "kernel" includes it
    secs s_total $((fin - kern)); secs s_user $((fin - user))
    if [ "$initrd" -gt 0 ]; then
        secs s_kern $((initrd - kern)); secs s_initrd $((user - initrd))
        times="boot ${s_total}s (kernel ${s_kern}s + initrd ${s_initrd}s + userspace ${s_user}s)"
    else
        secs s_kern $((user - kern))
        times="boot ${s_total}s (kernel ${s_kern}s + userspace ${s_user}s)"
    fi
    [ $((fin - kern)) -le $((SLOW_TOTAL * 1000000)) ] || slow="total above ${SLOW_TOTAL}s"
fi
# shellcheck disable=SC2086
median=$(printf '%s\n' $benches | sort -n | sed -n "$(( (count + 1) / 2 ))p")
ref=$fastest; [ "$ref" -ge "$FLOOR" ] || ref=$FLOOR
ratio=$((slowest * 10 / ref))
if [ "$slowest" -ge $((ref * SLOW_RATIO)) ]; then
    slow="${slow:+$slow, }slowest benchmark $((ratio / 10)).$((ratio % 10))x the fastest"
fi
if [ "$SLOW_BENCH_MS" -gt 0 ] && [ "$slowest" -ge "$SLOW_BENCH_MS" ]; then
    slow="${slow:+$slow, }benchmark ${slowest}ms >= ${SLOW_BENCH_MS}ms"
fi
if [ -n "$slow" ]; then
    snapshot "end"
else
    temps
fi

# order of "clk: Disabling unused clocks" (late initcall) and cpufreq coming online (docs/known-issues.md#boot)
PATTERN='clk: Disabling unused clocks|cpufreq_policy_online'
kl=$(dmesg 2>/dev/null | grep -n -E "$PATTERN")
case $kl in
    *'Disabling unused clocks'*cpufreq_policy_online*|*cpufreq_policy_online*'Disabling unused clocks'*) ;;
    *) kl=$(journalctl -k -b 0 -o short-monotonic --no-pager 2>/dev/null | grep -n -E "$PATTERN") ;;
esac
clk_line=-; clk_t=; cpf_line=-; cpf_t=
while IFS= read -r l; do
    n=${l%%:*}; t=${l#*\[}; t=${t%%\]*}; t=${t#"${t%%[! ]*}"}
    case $n in ''|*[!0-9]*) continue ;; esac
    case $l in
        *'Disabling unused clocks'*) [ "$clk_line" = - ] && clk_line=$n && clk_t=$t ;;
        *cpufreq_policy_online*) [ "$cpf_line" = - ] && cpf_line=$n && cpf_t=$t ;;
    esac
done <<EOF
$kl
EOF
if [ "$clk_line" = - ] || [ "$cpf_line" = - ]; then
    missing=; [ "$clk_line" != - ] || missing=" unused clocks"; [ "$cpf_line" != - ] || missing="$missing cpufreq"
    order="order of clocks and cpufreq unknown (kernel messages not found:$missing)"
elif [ "$clk_line" -lt "$cpf_line" ]; then
    order="unused clocks off ${clk_t}s, cpufreq ${cpf_t}s: clocks before cpufreq"
else
    order="cpufreq ${cpf_t}s, unused clocks off ${clk_t}s: cpufreq before clocks"
fi

line="$times; CPU benchmark $fastest/$median/$slowest ms (fastest/median/slowest of $count, $bench_kind time); cpu0 $cur kHz (hw $hw), online $online, max ${tmax:-?} C; $order"
if [ -z "$slow" ]; then
    echo "<6>$line"
    echo "$line" 2>/dev/null > "$OUT/report"
else
    echo "<4>SLOW $line; SLOW: $slow (samples and clock state follow)"
    echo "SLOW $line; SLOW: $slow" 2>/dev/null > "$OUT/report"
    for f in "$OUT/samples" $files; do
        [ -r "$f" ] || continue
        while IFS= read -r l; do echo "<6>$l"; done 2>/dev/null < "$f"
    done
fi
exit 0
